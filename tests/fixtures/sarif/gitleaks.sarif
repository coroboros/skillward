{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "gitleaks",
          "rules": [
            { "id": "aws-access-token", "properties": { "security-severity": "9.1" } }
          ]
        }
      },
      "results": [
        {
          "ruleId": "aws-access-token",
          "level": "error",
          "message": { "text": "AWS Access Key ID detected" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "/scan/setup.sh" },
                "region": { "startLine": 3 }
              }
            }
          ]
        }
      ]
    }
  ]
}
