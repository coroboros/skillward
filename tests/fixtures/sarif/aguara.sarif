{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "aguara",
          "rules": [
            { "id": "typosquat-dependency", "properties": { "security-severity": "8.0" } }
          ]
        }
      },
      "results": [
        {
          "ruleId": "typosquat-dependency",
          "level": "error",
          "message": { "text": "requestz is a likely typosquat of requests" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "/scan/requirements.txt" },
                "region": { "startLine": 2 }
              }
            }
          ]
        }
      ]
    }
  ]
}
