{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "trivy",
          "rules": [
            { "id": "aws-secret-access-key", "properties": { "security-severity": "9.1" } },
            { "id": "CVE-2021-33503", "properties": { "security-severity": "7.5" } }
          ]
        }
      },
      "results": [
        {
          "ruleId": "aws-secret-access-key",
          "level": "error",
          "message": { "text": "hardcoded AWS secret credential" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "/scan/setup.sh" },
                "region": { "startLine": 3 }
              }
            }
          ]
        },
        {
          "ruleId": "CVE-2021-33503",
          "level": "error",
          "message": { "text": "urllib3 vulnerable to ReDoS (CVE-2021-33503)" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "/scan/requirements.txt" },
                "region": { "startLine": 3 }
              }
            }
          ]
        }
      ]
    }
  ]
}
