{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": { "driver": { "name": "semgrep" } },
      "results": [
        {
          "ruleId": "dangerous-eval-on-tainted-data",
          "level": "error",
          "message": { "text": "eval on attacker-controlled payload (command injection)" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "/scan/setup.sh" },
                "region": { "startLine": 7 }
              }
            }
          ]
        },
        {
          "ruleId": "unpinned-action-pull-request-target",
          "level": "warning",
          "message": { "text": "unsafe GitHub Action: unpinned checkout under pull_request_target" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "/scan/.github/workflows/ci.yml" },
                "region": { "startLine": 9 }
              }
            }
          ]
        }
      ]
    }
  ]
}
