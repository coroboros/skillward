{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": { "driver": { "name": "skillspector" } },
      "results": [
        {
          "ruleId": "prompt-injection",
          "level": "error",
          "message": { "text": "hidden instruction overrides agent behavior" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "/scan/SKILL.md" },
                "region": { "startLine": 9 }
              }
            }
          ]
        },
        {
          "ruleId": "exec-sink-eval",
          "level": "error",
          "message": { "text": "tainted data reaches eval (taint to exec)" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "/scan/setup.sh" },
                "region": { "startLine": 7 }
              }
            }
          ]
        }
      ]
    }
  ]
}
